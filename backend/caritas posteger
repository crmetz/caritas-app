CREATE FUNCTION public.fn_atualizar_saldo_caixa() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN

    IF UPPER(NEW.tipo_movimentacao) = 'ENTRADA' THEN

        UPDATE caixa
           SET saldo_atual = saldo_atual + NEW.valor
         WHERE id_caixa = NEW.id_caixa;

    ELSIF UPPER(NEW.tipo_movimentacao) = 'SAIDA' THEN

        UPDATE caixa
           SET saldo_atual = saldo_atual - NEW.valor
         WHERE id_caixa = NEW.id_caixa;

    END IF;

    RETURN NEW;

END;
$$;


