# Copie para .env na raiz e preencha antes de subir a stack de produção:
#   cp .env.example .env
# O .env NÃO é versionado (está no .gitignore).

# ---------- Banco de dados ----------
POSTGRES_DB=caritas
POSTGRES_USER=caritas
# Gere uma senha forte: openssl rand -base64 24
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA

# ---------- JWT ----------
# OBRIGATÓRIO: a API lança "Jwt:Key não configurado." no startup se estiver vazio.
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_KEY=TROQUE_POR_UMA_CHAVE_COM_NO_MINIMO_32_CARACTERES
JWT_ISSUER=caritas-api
JWT_AUDIENCE=caritas-app

# Admin inicial — só precisa estar preenchido no PRIMEIRO deploy; depois esvazie as duas.
# A senha precisa ter no mínimo 8 caracteres, com um dígito e uma maiúscula.
SEED_ADMIN_EMAIL=admin@caritas.com
SEED_ADMIN_PASSWORD=TROQUE_ESTA_SENHA_Admin1

# ---------- Porta publicada / URL pública ----------
# A VM de deploy compartilha o host com um servidor de e-mail (mailcow) que ocupa
# as portas 80 e 443 — use sempre uma porta alta e confira antes com "ss -tulpn".
APP_PORT=8081

# Usada para montar o link dos e-mails de recuperação de senha.
# Precisa incluir a porta e não pode ter barra no final.
# Ex.: http://177.104.188.217:8081 ou https://caritas.suaorg.org
FRONTEND_URL=http://SEU-IP-PUBLICO:8081

# ---------- SMTP (envio de e-mails) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SENDER_EMAIL=seu-email@gmail.com
SMTP_SENDER_NAME=Cáritas
SMTP_USERNAME=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
SMTP_ENABLE_SSL=true
