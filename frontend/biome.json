{
	"$schema": "https://biomejs.dev/schemas/2.2.6/schema.json",
	"vcs": { "enabled": false, "clientKind": "git", "useIgnoreFile": false },
	"files": {
		"ignoreUnknown": false,
		"includes": ["./src/**/*"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"includes": ["./src/**/*"]
	},
	"assist": {
		"actions": { "source": { "organizeImports": "on", "recommended": true } }
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"useKeyWithClickEvents": "off",
				"noStaticElementInteractions": "off",
				"useButtonType": "off"
			},
			"complexity": {
				"noBannedTypes": "off",
				"noForEach": "off",
				"noStaticOnlyClass": "off",
				"noUselessFragments": "off"
			},
			"correctness": {
				"useExhaustiveDependencies": "off",
				"noUnusedImports": "on",
				"noUnusedVariables": "warn"
			},
			"style": {
				"noNonNullAssertion": "off",
				"noDefaultExport": "off"
			},
			"suspicious": {
				"noArrayIndexKey": "info",
				"noExplicitAny": "off",
				"noConsole": "warn",
				"noThenProperty": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all"
		}
	}
}
